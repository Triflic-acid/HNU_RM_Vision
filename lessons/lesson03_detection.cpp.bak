namespace training {
// 第三讲：装甲板检测
// 输入：不可修改的 CV_8UC3 BGR 图像。
// 输出：Armor 列表；角点顺序为左上、右上、右下、左下，单位为像素。
// 图像坐标原点在左上；无法识别编号时 class_id=-1；没有装甲板时返回空列表。

constexpr int kInput = 640;

cv::Mat letterbox(const cv::Mat& src, int size, float& scale, int& pad_x, int& pad_y) {
  const int w = src.cols, h = src.rows;
  scale = std::min(size / static_cast<float>(w), size / static_cast<float>(h));
  const int nw = static_cast<int>(std::round(w * scale));
  const int nh = static_cast<int>(std::round(h * scale));
  pad_x = (size - nw) / 2;
  pad_y = (size - nh) / 2;

  cv::Mat out(size, size, CV_8UC3, cv::Scalar(114, 114, 114));
  cv::Mat resized;
  cv::resize(src, resized, cv::Size(nw, nh));
  resized.copyTo(out(cv::Rect(pad_x, pad_y, nw, nh)));
  return out;
}
